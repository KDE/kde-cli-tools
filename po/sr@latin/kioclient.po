#: kioclient.cpp:56
#, kde-format
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Sintaksa:\n"

# literal-segment: 'url'
#: kioclient.cpp:58
#, kde-format
msgctxt "The argument is the command \"kioclient openProperties\""
msgid ""
"  %1 'url'\n"
"            # Opens a properties dialog of 'url'\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Otvara dijalog svojstava za URL\n"
"\n"

#: kioclient.cpp:65
#, kde-format
msgctxt "The argument is the command \"kioclient exec\""
msgid ""
"  %1 'url' ['mimetype']\n"
"            # Tries to open the document pointed to by 'url', in the "
"application\n"
"            # associated with it in KDE. You may omit 'mimetype'.\n"
"            # In that case the mimetype is determined automatically.\n"
"            # 'url' can be the URL of a document, a *.desktop file,\n"
"            # or an executable.\n"
msgstr ""
"  %1 'url' ['mimetip']\n"
"            # Pokušava da otvori dokument na koji pokazuje URL, u programu\n"
"            # koji mu je pridružen u KDE‑u. MIME tip se može izostaviti.\n"
"            # U tom slučaju MIME tip se određuje automatski.\n"
"            # URL može biti URL dokumenta, *.desktop fajl\n"
"            # ili izvršni fajl.\n"

#: kioclient.cpp:76
#, kde-format
msgctxt "The argument is the command \"kioclient move\""
msgid ""
"  %1 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"            #   'dest' may be \"trash:/\" to move the files to the trash.\n"
"            #   The short version 'kioclient mv' is also available.\n"
"\n"
msgstr ""
"  %1 'izvor' 'odrediste'\n"
"            # Premešta URL sa izvora na odredište.\n"
"            #   Izvor može biti i spisak URL‑ova.\n"
"            #   Odredište može biti „trash:/“, za premeštanje fajlova u "
"smeće.\n"
"            #   Dostupna je i kratka verzija kioclient mv.\n"
"\n"

#: kioclient.cpp:86
#, kde-format
msgctxt "The argument is the command \"kioclient download\""
msgid ""
"  %1 ['src']\n"
"            # Copies the URL 'src' to a user-specified location.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
"  %1 ['izvor']\n"
"            # Kopira URL izvora na korisnički zadatu lokaciju.\n"
"            #   Izvor može biti i spisak URL‑ova; ako nije zadat,\n"
"            #   URL će biti zatražen.\n"
"\n"

#: kioclient.cpp:95
#, kde-format
msgctxt "The argument is the command \"kioclient copy\""
msgid ""
"  %1 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"            #   The short version 'kioclient cp' is also available.\n"
"\n"
msgstr ""
"  %1 'izvor' 'odrediste'\n"
"            # Kopira URL izvora na odredište.\n"
"            #   Izvor može biti i spisak URL‑ova.\n"
"            #   Dostupna je i kratka verzija kioclient cp.\n"
"\n"

#: kioclient.cpp:104
#, kde-format
msgctxt "The argument is the command \"kioclient cat\""
msgid ""
"  %1 'url'\n"
"            # Prints the contents of the file 'url' to the standard output\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Ispisuje sadržaj fajla URL‑a na standardni izlaz\n"
"\n"

#: kioclient.cpp:111
#, kde-format
msgctxt "The argument is the command \"kioclient ls\""
msgid ""
"  %1 'url'\n"
"            # Lists the contents of the directory 'url' to stdout\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Ispisuje sadržaj fascikle URL‑a na stdiz\n"
"\n"

#: kioclient.cpp:118
#, kde-format
msgctxt "The argument is the command \"kioclient remove\""
msgid ""
"  %1 'url'\n"
"            # Removes the URL\n"
"            #   'url' may be a list of URLs.\n"
"            #   The short version 'kioclient rm' is also available.\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Uklanja URL\n"
"            #   (može se navesti i spisak URL‑ova).\n"
"            #   Dostupna je i kratka verzija kioclient rm.\n"
"\n"

#: kioclient.cpp:127
#, kde-format
msgctxt "The argument is the command \"kioclient mkdir\""
msgid ""
"  %1 'url'\n"
"            # Creates a directory at 'url'\n"
msgstr ""
"  %1 'url'\n"
"            # Pravi fasciklu na URL‑u\n"

#: kioclient.cpp:134
#, kde-format
msgctxt "The argument is the command \"kioclient stat\""
msgid ""
"  %1 'url'\n"
"            # Shows all of the available information for 'url'\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Prikazuje sve dostupne podatke o URL‑u\n"
"\n"

#: kioclient.cpp:141
#, kde-format
msgctxt "The argument is the command \"kioclient appmenu\""
msgid ""
"  %1\n"
"            # Opens a basic application launcher\n"
"\n"
msgstr ""
"  %1\n"
"            # Otvara osnovni pokretač programa\n"
"\n"

#: kioclient.cpp:147
#, kde-format
msgid "*** Examples:\n"
msgstr "*** Primeri:\n"

#: kioclient.cpp:148
#, kde-format
msgid ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with the default application associated\n"
"             // with this MimeType\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             # Otvara fajl podrazumevanim programom pridruženim\n"
"             # ovom MIME tipu\n"
"\n"

#: kioclient.cpp:153
#, kde-format
msgid ""
"  kioclient exec ftp://localhost/\n"
"             // Opens URL with the default handler for ftp:// scheme\n"
"\n"
msgstr ""
"  kioclient exec ftp://localhost/\n"
"             # Otvara URL podrazumevanim rukovaocem za šemu ftp://\n"
"\n"

# literal-segment: kioclient exec file:/root/Desktop/emacs.desktop
#: kioclient.cpp:157
#, kde-format
msgid ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             # pokreće Emacs\n"
"\n"

#: kioclient.cpp:161
#, kde-format
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory in the default\n"
"             // file manager. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             # Otvara tekuću fasciklu podrazumevanim\n"
"             # menadžerom fajlova — vrlo zgodno.\n"
"\n"

