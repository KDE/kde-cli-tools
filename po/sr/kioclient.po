#: kioclient.cpp:56
#, kde-format
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Синтакса:\n"

# literal-segment: 'url'
#: kioclient.cpp:58
#, kde-format
msgctxt "The argument is the command \"kioclient openProperties\""
msgid ""
"  %1 'url'\n"
"            # Opens a properties dialog of 'url'\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Отвара дијалог својстава за УРЛ\n"
"\n"

#: kioclient.cpp:65
#, kde-format
msgctxt "The argument is the command \"kioclient exec\""
msgid ""
"  %1 'url' ['mimetype']\n"
"            # Tries to open the document pointed to by 'url', in the "
"application\n"
"            # associated with it in KDE. You may omit 'mimetype'.\n"
"            # In that case the mimetype is determined automatically.\n"
"            # 'url' can be the URL of a document, a *.desktop file,\n"
"            # or an executable.\n"
msgstr ""
"  %1 'url' ['mimetip']\n"
"            # Покушава да отвори документ на који показује УРЛ, у програму\n"
"            # који му је придружен у КДЕ‑у. МИМЕ тип се може изоставити.\n"
"            # У том случају МИМЕ тип се одређује аутоматски.\n"
"            # УРЛ може бити УРЛ документа, *.desktop фајл\n"
"            # или извршни фајл.\n"

#: kioclient.cpp:76
#, kde-format
msgctxt "The argument is the command \"kioclient move\""
msgid ""
"  %1 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"            #   'dest' may be \"trash:/\" to move the files to the trash.\n"
"            #   The short version 'kioclient mv' is also available.\n"
"\n"
msgstr ""
"  %1 'izvor' 'odrediste'\n"
"            # Премешта УРЛ са извора на одредиште.\n"
"            #   Извор може бити и списак УРЛ‑ова.\n"
"            #   Одредиште може бити „trash:/“, за премештање фајлова у "
"смеће.\n"
"            #   Доступна је и кратка верзија kioclient mv.\n"
"\n"

#: kioclient.cpp:86
#, kde-format
msgctxt "The argument is the command \"kioclient download\""
msgid ""
"  %1 ['src']\n"
"            # Copies the URL 'src' to a user-specified location.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
"  %1 ['izvor']\n"
"            # Копира УРЛ извора на кориснички задату локацију.\n"
"            #   Извор може бити и списак УРЛ‑ова; ако није задат,\n"
"            #   УРЛ ће бити затражен.\n"
"\n"

#: kioclient.cpp:95
#, kde-format
msgctxt "The argument is the command \"kioclient copy\""
msgid ""
"  %1 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"            #   The short version 'kioclient cp' is also available.\n"
"\n"
msgstr ""
"  %1 'izvor' 'odrediste'\n"
"            # Копира УРЛ извора на одредиште.\n"
"            #   Извор може бити и списак УРЛ‑ова.\n"
"            #   Доступна је и кратка верзија kioclient cp.\n"
"\n"

#: kioclient.cpp:104
#, kde-format
msgctxt "The argument is the command \"kioclient cat\""
msgid ""
"  %1 'url'\n"
"            # Prints the contents of the file 'url' to the standard output\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Исписује садржај фајла УРЛ‑а на стандардни излаз\n"
"\n"

#: kioclient.cpp:111
#, kde-format
msgctxt "The argument is the command \"kioclient ls\""
msgid ""
"  %1 'url'\n"
"            # Lists the contents of the directory 'url' to stdout\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Исписује садржај фасцикле УРЛ‑а на стдиз\n"
"\n"

#: kioclient.cpp:118
#, kde-format
msgctxt "The argument is the command \"kioclient remove\""
msgid ""
"  %1 'url'\n"
"            # Removes the URL\n"
"            #   'url' may be a list of URLs.\n"
"            #   The short version 'kioclient rm' is also available.\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Уклања УРЛ\n"
"            #   (може се навести и списак УРЛ‑ова).\n"
"            #   Доступна је и кратка верзија kioclient rm.\n"
"\n"

#: kioclient.cpp:127
#, kde-format
msgctxt "The argument is the command \"kioclient mkdir\""
msgid ""
"  %1 'url'\n"
"            # Creates a directory at 'url'\n"
msgstr ""
"  %1 'url'\n"
"            # Прави фасциклу на УРЛ‑у\n"

#: kioclient.cpp:134
#, kde-format
msgctxt "The argument is the command \"kioclient stat\""
msgid ""
"  %1 'url'\n"
"            # Shows all of the available information for 'url'\n"
"\n"
msgstr ""
"  %1 'url'\n"
"            # Приказује све доступне податке о УРЛ‑у\n"
"\n"

#: kioclient.cpp:141
#, kde-format
msgctxt "The argument is the command \"kioclient appmenu\""
msgid ""
"  %1\n"
"            # Opens a basic application launcher\n"
"\n"
msgstr ""
"  %1\n"
"            # Отвара основни покретач програма\n"
"\n"

#: kioclient.cpp:147
#, kde-format
msgid "*** Examples:\n"
msgstr "*** Примери:\n"

#: kioclient.cpp:148
#, kde-format
msgid ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with the default application associated\n"
"             // with this MimeType\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             # Отвара фајл подразумеваним програмом придруженим\n"
"             # овом МИМЕ типу\n"
"\n"

#: kioclient.cpp:153
#, kde-format
msgid ""
"  kioclient exec ftp://localhost/\n"
"             // Opens URL with the default handler for ftp:// scheme\n"
"\n"
msgstr ""
"  kioclient exec ftp://localhost/\n"
"             # Отвара УРЛ подразумеваним руковаоцем за шему ftp://\n"
"\n"

# literal-segment: kioclient exec file:/root/Desktop/emacs.desktop
#: kioclient.cpp:157
#, kde-format
msgid ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             # покреће Емакс\n"
"\n"

#: kioclient.cpp:161
#, kde-format
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory in the default\n"
"             // file manager. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             # Отвара текућу фасциклу подразумеваним\n"
"             # менаџером фајлова — врло згодно.\n"
"\n"

